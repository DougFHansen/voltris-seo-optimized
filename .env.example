# ========================================
# VARIÁVEIS DE AMBIENTE - MERCADO PAGO
# ========================================

# [MERCADO PAGO DEBUG] Token de acesso do Mercado Pago
# IMPORTANTE: 
# - Para TESTE: Use token que comece com TEST-
# - Para PRODUÇÃO: Use token que comece com APP_USR-
# - Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials
# - NUNCA exponha este token no frontend
#
# ⚠️ ATENÇÃO PARA TESTES EM SANDBOX:
# Se você usar um token APP_USR- (produção), os pagamentos de teste FALHARÃO
# mesmo que o sandbox_init_point seja gerado. Use um token TEST- para sandbox.
#
# EXEMPLO CORRETO PARA TESTES:
# MP_ACCESS_TOKEN=TEST-1234567890123456-010100-abcdef1234567890abcdef1234567890-123456789
#
# EXEMPLO ATUAL (PRODUÇÃO - NÃO FUNCIONA EM SANDBOX):
MP_ACCESS_TOKEN=TEST-your_mercadopago_token_here

# [MERCADO PAGO DEBUG] URL do site
# Usado para construir URLs de retorno (sucesso/falha) e webhook
# IMPORTANTE: Não incluir barra (/) no final
NEXT_PUBLIC_SITE_URL=https://voltris.com.br

# ========================================
# SUPABASE
# ========================================

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Chave pública (anon key) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Chave de serviço (service role) do Supabase
# IMPORTANTE: Apenas usar no backend, nunca expor no frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========================================
# NODE.JS
# ========================================

# Versão do Node.js
NODE_VERSION=22.x

# PagBank Credentials
# Docs: https://dev.pagbank.uol.com.br/reference/autenticacao
PAGBANK_ENV="sandbox"
PAGBANK_TOKEN="YOUR_PAGBANK_TOKEN_HERE"
PAGBANK_WEBHOOK_AUTH_TOKEN="YOUR_SECURE_RANDOM_TOKEN_HERE"

# ========================================
# STRIPE (pagamento real das licenças)
#
# IMPORTANTE — a chave que vale é a de LIVE em produção:
#   STRIPE_SECRET_KEY        -> sk_live_... (servidor; NUNCA expor)
#   STRIPE_WEBHOOK_SECRET    -> segredo do endpoint /api/webhook/stripe
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY -> pk_live_... (pode ir pro navegador)
#
# O par (chave secreta, segredo do webhook) PRECISA ser do MESMO modo. Usar
# sk_test_ com o segredo do endpoint live faz todo evento ser rejeitado com
# 400 — e foi exatamente assim que pagamentos aprovados ficaram "pending".
# ========================================
STRIPE_SECRET_KEY=sk_test_sua_chave_de_teste
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_do_endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publica

# Defina como "1" quando a versão da API da Stripe instalada aceitar
# `cancellation_details` no cancelamento (registra o motivo do cancelamento).
# Fora disso o cancelamento segue funcionando, só sem o comentário.
# STRIPE_API_SUPPORTS_CANCELLATION_DETAILS=0

# ========================================
# DADOS DA EMPRESA PARA DOCUMENTOS COMERCIAIS (fatura PDF)
#
# A razão social e o CNPJ são DADO FISCAL/contratual, não código: alterá-los
# não pode exigir deploy. Preencha na Vercel.
# O CNPJ é validado por dígito verificador no servidor; se vier inválido, o
# documento sai SEM o campo (nunca com um número errado).
# ========================================
VOLTRIS_RAZAO_SOCIAL=VOLTRIS TECNOLOGIA LTDA
VOLTRIS_NOME_FANTASIA=VOLTRIS
VOLTRIS_CNPJ=47.241.737/0001-60
VOLTRIS_ENDERECO=São Paulo, SP — Brasil
VOLTRIS_CIDADE=São Paulo
VOLTRIS_UF=SP
VOLTRIS_CEP=
VOLTRIS_EMAIL=contato@voltris.com.br
VOLTRIS_TELEFONE=(11) 99671-6235
VOLTRIS_SITE=https://www.voltris.com.br

# ========================================
# WEB PUSH (VAPID)
# Gere com: npx web-push generate-vapid-keys
# ========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ========================================
# LICENÇA
# Chave secreta para geração de licenças (deve ser igual ao C# LicenseGenerator)
# ========================================
LICENSE_SECRET_KEY=your_license_secret_key_here

# URL base do site (sem barra no final).
#
# É daqui que saem as URLs de VOLTA do checkout da Stripe
# (a `success_url` que leva o cliente de volta ao painel, na aba
# "Minhas Licenças") e os links dos e-mails.
#
# REGRAS:
#   - produção: https://www.voltris.com.br  (https OBRIGATÓRIO e com www,
#     que é o domínio canônico — o outro host faz um 308 extra e o salto
#     de host pode perder a sessão do cliente);
#   - desenvolvimento: http://localhost:3000 (o checkout em teste precisa
#     voltar para o servidor LOCAL, não para a produção).
#
# Por segurança, o código (lib/site-url.ts) normaliza o valor: nunca gera
# URL de retorno em http fora de localhost, e prefere a origem real da
# requisição quando ela é comprovadamente do mesmo site.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ========================================
# SIMULADOR DE VENDAS (cron do Vercel)
# Chave secreta exigida por /api/simulator/send-sale (Bearer ou ?key=)
# ========================================
SIMULATOR_SECRET_KEY=your_secure_random_simulator_secret

# ========================================
# INDEXNOW
# Chave da API IndexNow (também publicada em https://www.voltris.com.br/{key}.txt)
# ========================================
INDEXNOW_API_KEY=your_indexnow_api_key_here

# ========================================
# RESEND (e-mail transacional — compras, licenças e faturas)
#
# O que cada uma controla:
#   RESEND_API_KEY           credencial da API. Servidor apenas, NUNCA no cliente.
#   RESEND_FROM_EMAIL        remetente. TEM que ser do domínio verificado
#                            (voltris.com.br) — a Resend recusa com 403/422 caso
#                            contrário, e a falha aparece como "SENDER" no outbox.
#   RESEND_FROM_NAME         nome exibido no campo "De".
#   RESEND_WEBHOOK_SECRET    segredo do endpoint /api/webhook/resend. É um
#                            webhook DIFERENTE do da Stripe: os segredos nunca
#                            podem ser reutilizados entre os dois provedores.
#                            Sem ele, a rota responde 503 em vez de aceitar
#                            qualquer coisa (senão dava para forjar "entregue").
#   EMAIL_CRON_SECRET        autoriza chamadas manuais ao worker por header
#                            `x-cron-secret`. Gere algo longo e aleatório.
#
# AFERIÇÃO DE CONFIGURAÇÃO (roda em tempo de execução, não só no deploy):
#   GET /api/email/outbox  -> { config: { configured, problems[] } }
# Se `configured: false`, nenhum e-mail sai — mas nenhuma compra se perde:
# elas ficam em `pending` e saem assim que a chave for corrigida.
# ========================================
RESEND_API_KEY=re_sua_chave_da_resend
RESEND_FROM_EMAIL=faturas@voltris.com.br
RESEND_FROM_NAME=VOLTRIS
RESEND_WEBHOOK_SECRET=whsec_seu_segredo_do_webhook_resend
EMAIL_CRON_SECRET=your_secure_random_cron_secret

# ========================================
# AGENDAMENTO DA FILA DE E-MAIL
#
# O cron da Vercel (vercel.json -> crons) chama POST /api/email/outbox a cada
# 5 minutos. Ele já é considerado confiável pela plataforma: a Vercel injeta o
# header `x-vercel-cron`, que uma chamada externa não consegue forjar.
#
# Se a sua conta da Vercel não tiver cron disponível, não há problema: quem
# processa a fila é a própria função. O webhook também drena a fila logo após
# enfileirar, e a aba "E-mails" do painel admin tem o botão "Processar fila
# agora". O cron é a garantia de que um e-mail pendente NÃO fica parado.
# ========================================

# ========================================
# DIAGNOSTICOS DA EXTENSAO VOLTRIS SHIELD
# ========================================

# Token do bot @ExtensionVoltrisBot, que recebe os alertas de falha da
# extensao de navegador. FICA SO NO SERVIDOR: nunca vai para a extensao.
TELEGRAM_EXTENSION_BOT_TOKEN=

# chat_id do grupo privado "Extensao Voltris Shield".
TELEGRAM_EXTENSION_CHAT_ID=-5322131301

# Habilita a rota de teste controlado /api/extension/diagnostics/test.
# Sem este valor, a rota devolve 404. Gere um valor aleatorio longo.
DIAGNOSTICS_ADMIN_TOKEN=

# Interruptor global: com "1", nada e enviado ao Telegram.
# DIAGNOSTICS_FORWARDING_DISABLED=1

# Historico no Supabase. DESLIGADO por padrao: sem esta variavel a rota
# nao toca o banco (nem leitura nem escrita) e o alerta do Telegram sai
# do mesmo jeito. Para ligar o historico, aplique tambem
# supabase/extension_diagnostics.sql.
# DIAGNOSTICS_PERSIST=1
